{
  "name": "oso-ahia",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n v2,console,convex -c cyan,magenta,yellow \"bun run dev:v2\" \"bun run dev:console\" \"bun run dev:backend\"",
    "dev:v2": "bun run --cwd apps/v2 dev",
    "dev:backend": "bun run --cwd packages/backend dev",
    "dev:console": "bun run --cwd apps/console dev",
    "build": "bun run --cwd apps/v2 build",
    "build:console": "bun run --cwd apps/console build",
    "dev:mobile": "bun run --cwd apps/mobile start"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
