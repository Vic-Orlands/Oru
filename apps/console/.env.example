# The same Convex deployment and Better Auth session as the web app (apps/web).
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# The web app this console administers and whose Better Auth endpoint it uses.
# Defaults to http://localhost:3000. The console origin must also be included in
# the backend's CONSOLE_URL so Better Auth accepts its requests.
# VITE_APP_URL=https://app.your-domain

# PostHog (client analytics). Public, write-only ingest key — safe to ship to
# the browser. Leave unset to disable analytics.
# VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Extra hosts allowed to reach the dev server, comma-separated.
# DEV_ALLOWED_ORIGINS=my-laptop.local
