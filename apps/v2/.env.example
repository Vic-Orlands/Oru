# Copy to apps/v2/.env.local. Demo mode runs the desk without any of these keys.

# ---- Demo -------------------------------------------------------------------

# Force the sample workspace on or off. When unset, demo turns on if
# NEXT_PUBLIC_GOOGLE_CLIENT_ID is empty.
NEXT_PUBLIC_DEMO_MODE=true

# ---- Required once you leave demo ------------------------------------------

# Printed by `bunx convex dev` in packages/backend. The site URL must end in
# .convex.site (better-auth refuses .convex.cloud).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public origin of this Next app. Auth cookies and canonical URLs use it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (Cloud console → Credentials). The redirect URI is
# {NEXT_PUBLIC_SITE_URL}/api/auth/callback/google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional ---------------------------------------------------------------

# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# AXIOM_TOKEN=xaat_your_ingest_token
# AXIOM_DATASET=web

# Median support widget. Without MEDIAN_KEY the Support item hides.
# MEDIAN_KEY=median_key_...
# MEDIAN_SUPPORT_SECRET=...

# Version string for the "update available" prompt. Vercel fills its own.
# GIT_COMMIT_SHA=...

# Extra hosts allowed to reach the dev server, comma-separated.
# DEV_ALLOWED_ORIGINS=my-laptop.local,192.168.1.20
