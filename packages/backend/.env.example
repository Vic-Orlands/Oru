# Deployment used by `bunx convex dev` (written automatically on first run).
# CONVEX_DEPLOYMENT=dev:your-deployment

# Cloud agents should stay off your personal dev deployment:
# CONVEX_AGENT_MODE=anonymous

# Everything below is set on the Convex deployment itself:
#   bunx convex env set NAME value
# `bunx convex dev` is for development. `bunx convex deploy` is production only.

# ---- Auth (better-auth + Google) -------------------------------------------

# 32+ random bytes. openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Must match NEXT_PUBLIC_SITE_URL on the web app.
# SITE_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Convex sets CONVEX_SITE_URL on the deployment. Locally it is the .convex.site URL.

# ---- Models (OpenRouter) ----------------------------------------------------

# OPENROUTER_API_KEY=sk-or-v1-...
# Chat default. Kimi K2.6 unless you override it.
# OPENROUTER_CHAT_MODEL=moonshotai/kimi-k2.6
# Cheap tier in the picker.
# OPENROUTER_FAST_MODEL=openai/gpt-5.4-nano
# Heavy tier in the picker.
# OPENROUTER_HEAVY_MODEL=x-ai/grok-4.5
# Yes/no and classification (ICP fit, reply intent, dedupe, approval checks).
# Jev is OpenRouter's Decisions API, not a chat model.
# OPENROUTER_JUDGE_MODEL=typesafe/jev-1.13
# Used when Jev is unavailable. Structured JSON yes/no.
# OPENROUTER_JUDGE_FALLBACK_MODEL=openai/gpt-4.1-nano

# ---- Integrations -----------------------------------------------------------

# Composio sales toolkits (Gmail, Outlook, Calendar, HubSpot, Salesforce,
# Pipedrive, Apollo, LinkedIn, Slack, Sheets, and whatever the store lists).
# COMPOSIO_API_KEY=
# Encrypts MCP credentials. openssl rand -base64 32
# MCP_ENCRYPTION_KEY=

# ---- Media CDN (Cloudflare R2) ---------------------------------------------

# Browser media uploads use short-lived signed URLs and resolve to R2_PUBLIC_URL.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=oso-ahia-media
# R2_PUBLIC_URL=https://media.example.com

# ---- Optional features Whirl still reads -----------------------------------

# EXA_API_KEY=
# SUPERMEMORY_API_KEY=
# AUTUMN_SECRET_KEY=
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_LLM_PRIVACY_MODE=false
# BRAINTRUST_API_KEY=
# BRAINTRUST_PROJECT_NAME=Oso-Ahia
# AXIOM_TOKEN=
# AXIOM_DATASET=web
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Oso-Ahia <hello@your-domain>
# VERCEL_WEBHOOK_SECRET=
# MEDIAN_KEY=
# MEDIAN_SUPPORT_SECRET=
